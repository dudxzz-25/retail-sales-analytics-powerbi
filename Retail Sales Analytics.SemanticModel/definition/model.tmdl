model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table fVendas
ref table dClientes
ref table dProdutos
ref table dLojas
ref table dCanal
ref table fMetas
ref table dCalendario
ref table _Medidas

ref cultureInfo pt-BR

