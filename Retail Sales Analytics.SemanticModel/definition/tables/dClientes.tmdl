	column DataCadastro
		dataType: dateTime
		lineageTag: 30089a3e-89f6-4cf2-84bf-3e1eba841cca
		sourceColumn: DataCadastro

	partition dClientes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\\Users\\samsung\\Downloads\\Retail Sales Analytics\\data\\raw\\dClientes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    TrimmedText = Table.TransformColumns(PromotedHeaders, {{"NomeCliente", Text.Trim, type text}, {"Sexo", Text.Trim, type text}, {"FaixaEtaria", Text.Trim, type text}, {"Cidade", Text.Trim, type text}, {"Estado", Text.Trim, type text}, {"Regiao", Text.Trim, type text}}),
				    StandardizedRegion = Table.TransformColumns(TrimmedText, {{"Regiao", each if Text.Lower(_) = "sudeste" then "Sudeste" else if Text.Lower(_) = "sul" then "Sul" else if Text.Lower(_) = "nordeste" then "Nordeste" else if Text.Lower(_) = "centro-oeste" then "Centro-Oeste" else if Text.Lower(_) = "norte" then "Norte" else _, type text}}),
				    ChangedType = Table.TransformColumnTypes(StandardizedRegion, {{"ClienteID", Int64.Type}, {"Idade", Int64.Type}, {"DataCadastro", type date}}),
				    UniqueRows = Table.Distinct(ChangedType, {"ClienteID"})
				in
				    UniqueRows

