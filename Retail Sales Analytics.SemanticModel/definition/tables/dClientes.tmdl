table dClientes
	lineageTag: 7306d773-3106-4fcc-b074-aa5bc28c351e

	column ClienteID
		dataType: int64
		lineageTag: a952a90b-77ea-4e3b-a2ed-605f0152f78e
		sourceColumn: ClienteID

	column NomeCliente
		dataType: string
		lineageTag: 5200dcac-9b23-4528-aee1-4dafa62ebd1a
		sourceColumn: NomeCliente

	column Sexo
		dataType: string
		lineageTag: 0120a775-a8bb-4357-9543-902e7fd7c06a
		sourceColumn: Sexo

	column Idade
		dataType: int64
		lineageTag: 488904d4-2c90-4092-979e-ef2a5d5706f9
		sourceColumn: Idade

	column FaixaEtaria
		dataType: string
		lineageTag: e634fcd3-9d55-49d7-9793-a88e373c7dae
		sourceColumn: FaixaEtaria

	column Cidade
		dataType: string
		lineageTag: 8214a597-6768-4d64-bf64-009505eb59dc
		sourceColumn: Cidade

	column Estado
		dataType: string
		lineageTag: ca15d5aa-ed93-478c-a45c-d8452a34a560
		sourceColumn: Estado

	column Regiao
