	partition dLojas = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\\Users\\samsung\\Downloads\\Retail Sales Analytics\\data\\raw\\dLojas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Cleaned = Table.TransformColumns(PromotedHeaders, {{"Loja", Text.Trim, type text}, {"Cidade", Text.Trim, type text}, {"Estado", Text.Trim, type text}, {"Regiao", Text.Trim, type text}}),
				    ChangedType = Table.TransformColumnTypes(Cleaned, {{"LojaID", Int64.Type}}),
				    UniqueRows = Table.Distinct(ChangedType, {"LojaID"})
				in
				    UniqueRows

