table dLojas
	lineageTag: 7bd03bac-575f-4b31-b744-7d9e4f9264db

	column LojaID
		dataType: int64
		lineageTag: 465c9f40-1a21-45ae-9223-f8afdfab5b52
		sourceColumn: LojaID

	column Loja
		dataType: string
		lineageTag: 43986fe2-2769-4f18-b253-1f10c6778dc8
		sourceColumn: Loja

	column Cidade
		dataType: string
